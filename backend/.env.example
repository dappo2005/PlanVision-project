# Copy to backend/.env for local development; never commit the resulting file.
# Blank secret values are intentional NON-secret placeholders. Supply private values.
APP_ENV=development
SECRET_KEY=
DB_HOST=localhost
DB_PORT=3306
DB_USER=plantvision_app
DB_PASSWORD=
DB_NAME=plantvision_db
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
FLASK_DEBUG=0
USE_MOCK_DB=0
SKIP_MODEL_LOAD=0

# Only development/test may opt into USE_MOCK_DB=1 or SKIP_MODEL_LOAD=1.
# Staging/production require a stable private SECRET_KEY (>=32 characters),
# explicit DB credentials, HTTPS FRONTEND_URL and explicit HTTPS ALLOWED_ORIGINS.
# Wildcard origins, mock mode, skipped model loading and debug are forbidden there.

# Optional ChatAI (server-only). Leave blank to disable the integration.
GEMINI_API_KEY=

# Optional Google OAuth: configure all fields together in the provider console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Optional SMTP for password reset email. Supply credentials privately.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# See docs/SECURITY_PHASE_0_1.md before exposing this application.
